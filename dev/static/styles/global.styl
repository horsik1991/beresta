// @import './instruments/1vars.styl'

[class*="__container"]
	max-width: 1200px
	padding 0 15px
	margin 0 auto

body 
	font-size $fontSize
	font-family: $primeFont
	font-weight 500
	background-color #fff
	background-color $beige
	color $fontDarkBrown


	// Скролл заблокирован
	.lock & 
		overflow hidden
		touch-action none

// // Оболочка 
.wrapper 
	min-height 100%
	display flex
	flex-direction column
	overflow hidden
	// Прижимаем footer
	> main 
		flex 1 1 auto
	// Фикс для слайдеров
	> * 
		min-width 0
	
.hero
	background-color $beige
	container-type: inline-size
	padding-top 10px
	&__inner-wrap
		display grid
		grid-template-columns 2fr 2fr 1fr
		grid-template-rows 400px 1fr 1fr
		max-width: 1500px
		margin 0 auto
		padding 0 15px
		column-gap 30px
		@media(max-width 767px)
			grid-template-columns 1fr 2fr 1fr
			grid-template-rows minmax(200px, 1fr) 1fr 1fr
	&__title
		text-transform uppercase
		grid-column span 2 / span 2
		min-width: 0;              
		font-size: clamp(2.25rem, 10cqw, 10rem);
		line-height: 1.05;
		color $green
		margin 0 auto
		text-align center
		align-self center
	&__subtitle
		grid-row span 2 / span 2
		grid-column-start: 1
		grid-row-start 2
		font-size: clamp(1.25rem, 2cqw, 2rem);
		max-width: 300px
		margin 0 auto
		@media(max-width 767px)
			text-align center
			
	&__text
		margin 0
		align-items center
		grid-column-start: 2
		grid-row-start: 2
		font-family $secondFont
	&__img
		grid-row span 3 / span 3
		grid-column-start: 3
		grid-row-start: 1
		background-image: url('../img/1.jpg')
		background-size: cover
		background-repeat: no-repeat
		background-position: 50% 50%
		min-height: clamp(100px,25vw,400px)
		aspect-ratio: 3 / 4
		//min-width: 0
		border 10px solid #fff
		border-radius 140px 140px 0 0
		transform rotate(2deg)
		box-shadow 0px 0px 25px 3px #aaa
	&__item
		font-size 10px

.advantages
	background-color $darkBeige
	border-top 1px solid darken($darkBeige, 15%)
	border-bottom 1px solid darken($darkBeige, 15%)
	&__container
		display flex
		justify-content space-between
		align-items center
		height 100%
		min-height: 70px



		
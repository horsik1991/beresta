.about
	padding-top 70px
	&__container
		display flex
		justify-content space-between
		gap 20px
		flex-wrap: wrap
	&__inner-wrap
		display flex
		flex-direction: column
		row-gap clamp(5px, 4cqw ,15px)
		flex-basis: 50%
		@media(max-width 600px)
			flex-basis 100%
	&__link
		align-self flex-start
		@media(max-width 600px)
			text-align right
			align-self flex-end
			margin-top 5px
	&__title
		font-size: clamp(1.25rem, 4cqw, 2.25rem)
		flex-basis: 40%
		font-weight: 500
		align-self center
		@media(max-width 600px)
			flex-basis 100%
			text-align center
			margin 0 auto
	&__text
		font-family $secondFont
		margin 0
section.feedback
    .feedback__container
        .feedback__title-wrap        
            h3.feedback__title Обсудим Ввшу идею
            p.feedback__description Расскажите, какую вещь хотите создать и для кого. Уточним детали и рассчитаем стоимость.
        form(action="").feedback__form.form-feedback
            .form-feedback__input-wrap 
                label(for="phone") Телефон
                input(type="phone" id="phone" placeholder="+7(___) ___-__-__") 
            .form-feedback__input-wrap 
                label(for="name") Имя
                input(type="phone" id="name" placeholder="Как к Вам обращаться?") 
            .form-feedback__input-wrap 
                label(for="idea") Ваша идея
                textarea(id="idea" placeholder="Расскажите, что хочется получить, обсудим варианты") 
            .form-feedback__input-wrap 
                input(type="checkbox")
                label Согласен на обработку персональных данных в соответствии с 
                    a(href="#") политикой 
            button(type="submit").form-feedback__submit Отправить заявку



header.header
    section.header__top-menu.top-menu.header__container
        ul.top-menu__menu
            each link,name in {'О нас':'about.html', 'Оплата и доставка':'delivery.html', 'Новости':'news.html', 'Контакты':'contatcs.html'}
                li.top-menu__item
                    a(href=link)= name  
        .top-menu__account Личный кабинет
    section.header__body.body-header 
        .body-header__logo
        .body-header__search 
            input(type="text")
        .body-header__location Москва
        .body-header__feedback.feedback-header
            .feedback-header__phone 8-800-777-49-67
            .feedback-header__callback Заказать звонок 
        .body-header__user-area.user-area
            .user-area__favorite 
            .user-area__cart.cart-header 
                .cart-header__cart 
                .cart-header__sum
                    span.cart-header__num 0
                    span.cart-header__rub р.
                .cart-header__button Оформить заказ
    ul.header__catalog.catalog-header
        each link,name in {'Каталог ножей':'catalog.html','Клинковое оружие':'catalog-blades.html','Сувенирные изделия':'catalog-souvenir-weapon.html','Фонари ARMYTEK':'catalog-light-armytek', 'Сопуствующие товары':'catalog-related-products'}
            li.catalog-header__item
                a.catalog-header__link(href=link)= name
                    path(d="M14 9.536V7a4 4 0 0 1 4-4h1.5a.5.5 0 0 1 .5.5V5a4 4 0 0 1-4 4 4 4 0 0 0-4 4c0 2 1 3 1 5a5 5 0 0 1-1 3")
                    path(d="M4 9a5 5 0 0 1 8 4 5 5 0 0 1-8-4")
                    path(d="M5 21h14")
            .header-logo__title Береста
            .hedaer-logo__text Лазерная резка и гравировка
        ul.header__menu.header-menu
            each name,link in {'Главная':'main.html','Каталог':'catalog.html','Конструктор':'constructor.html','Контакты':'contacts.html'}
